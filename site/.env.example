# --- Base de données (PostgreSQL) ---
# Installation classique : adresse complète de la base
DATABASE_URI=postgres://swatter:motdepasse@127.0.0.1:5432/swatter
# Docker Compose : DATABASE_URI est construit à partir de ces variables (POSTGRES_PASSWORD obligatoire)
POSTGRES_USER=swatter
POSTGRES_PASSWORD=
POSTGRES_DB=swatter
# Port publié sur la machine (Docker Compose, accessible en local uniquement : placer un proxy HTTPS devant)
APP_PORT=3000
# Chaîne aléatoire longue (ex. : openssl rand -hex 32)
PAYLOAD_SECRET=
# URL publique du site (sans / final) ; en local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.swatter-tv.fr
# Secret de la tâche planifiée d'import (météo + chaîne YouTube) : GET /api/cron/import avec l'en-tête
# « Authorization: Bearer <CRON_SECRET> » (ex. : openssl rand -hex 32)
CRON_SECRET=

# --- Premier administrateur (script src/scripts/init-db.ts ; obligatoires en production) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Vidéos (facultatif) : bibliothèque Bunny Stream ---
NEXT_PUBLIC_BUNNY_LIBRARY_ID=
# Clé de l'API YouTube Data v3 (facultatif) : l'import de la chaîne reprend toutes ses vidéos, pas seulement les 15 dernières
YOUTUBE_API_KEY=

# --- Stockage des médias sur S3 / R2 / Scaleway (facultatif ; sinon dossier ./media) ---
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- E-mails de l'administration : « Mot de passe oublié » (facultatif ; sinon écrits dans le journal du serveur) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contact@swatter-tv.fr

# --- Reverse proxy (facultatif) : nombre de proxys en chaîne devant le site (1 par défaut ; 2 derrière un CDN puis Caddy) ---
TRUSTED_PROXY_HOPS=
