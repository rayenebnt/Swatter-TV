{
  "name": "swatter-tv",
  "version": "1.0.0",
  "private": true,
  "description": "Site de Swatter TV & Info — web TV locale (Haute-Savoie / Auvergne-Rhône-Alpes)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:brut": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "rapide": "npm run build && npm run start",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=6000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed.ts",
    "reinit": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/reinit.ts",
    "maj-base": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/maj-base.ts",
    "import": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/import.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-nodemailer": "3.91.0",
    "@payloadcms/live-preview-react": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/plugin-redirects": "3.91.0",
    "@payloadcms/plugin-seo": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "fast-xml-parser": "5.11.2",
    "graphql": "^16.8.1",
    "hls.js": "1.7.3",
    "next": "16.3.3",
    "payload": "3.91.0",
    "pg": "^8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
